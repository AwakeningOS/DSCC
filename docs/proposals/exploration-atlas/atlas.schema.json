{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dscc:atlas:0.1-draft",
  "title": "DSCC Exploration Atlas proposal payload (not a production protocol)",
  "oneOf": [{"$ref":"#/$defs/episode"},{"$ref":"#/$defs/bridge"},{"$ref":"#/$defs/transfer"},{"$ref":"#/$defs/motif"}],
  "$defs": {
    "cid": {"type":"string","pattern":"^bafkrei[a-z2-7]{52}$"},
    "id": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "origin": {"enum":["logged","self_report","model_extracted","synthetic","unknown"]},
    "source": {"type":"object","properties":{"cid":{"$ref":"#/$defs/cid"},"pointer":{"type":"string","pattern":"^(?:/(?:[^~]|~[01])*)*$"}},"required":["cid","pointer"],"additionalProperties":false},
    "producer": {"type":"object","properties":{"id":{"type":"string","minLength":1},"revision":{"type":"string","minLength":1}},"required":["id","revision"],"additionalProperties":false},
    "node": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"role":{"enum":["state","goal","constraint","proposal","action","expectation","observation","revision","question"]},"text":{"type":"string"},"stage":{"enum":["proposed","performed","stopped","unknown","not_applicable"]},"origin":{"$ref":"#/$defs/origin"},"sources":{"type":"array","items":{"$ref":"#/$defs/source"},"minItems":0}},"required":["id","role","text","stage","origin","sources"],"additionalProperties":false},
    "link": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"},"relation":{"enum":["precedes","motivates","expects","produces","revises","branches_to","uses"]},"origin":{"$ref":"#/$defs/origin"},"sources":{"type":"array","items":{"$ref":"#/$defs/source"},"minItems":0}},"required":["id","from","to","relation","origin","sources"],"additionalProperties":false},
    "binding": {"type":"object","properties":{"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"}},"required":["from","to"],"additionalProperties":false},
    "episode": {"type":"object","properties":{"schema":{"const":"dscc.atlas/0.1-draft"},"type":{"const":"Episode"},"title":{"type":"string","minLength":1},"topic_tags":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"goal":{"type":"string"},"conditions":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"nodes":{"type":"array","items":{"$ref":"#/$defs/node"},"minItems":1},"links":{"type":"array","items":{"$ref":"#/$defs/link"},"minItems":0},"open_questions":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"extractor":{"$ref":"#/$defs/producer"},"extensions":{"type":"object"}},"required":["schema","type","title","topic_tags","goal","conditions","nodes","links","open_questions","extractor","extensions"],"additionalProperties":false},
    "bridge": {"type":"object","properties":{"schema":{"const":"dscc.atlas/0.1-draft"},"type":{"const":"Bridge"},"source_episode":{"$ref":"#/$defs/cid"},"target_episode":{"$ref":"#/$defs/cid"},"mapping":{"type":"array","items":{"$ref":"#/$defs/binding"},"minItems":1},"matched_edges":{"type":"array","items":{"$ref":"#/$defs/binding"},"minItems":0},"common_structure":{"type":"string","minLength":1},"gaps":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"next_question":{"type":"string","minLength":1},"generator":{"$ref":"#/$defs/producer"},"extensions":{"type":"object"}},"required":["schema","type","source_episode","target_episode","mapping","matched_edges","common_structure","gaps","next_question","generator","extensions"],"additionalProperties":false},
    "transfer": {"type":"object","properties":{"schema":{"const":"dscc.atlas/0.1-draft"},"type":{"const":"TransferAssessment"},"bridge":{"$ref":"#/$defs/cid"},"trial_episode":{"$ref":"#/$defs/cid"},"verdict":{"enum":["helpful","not_helpful","inconclusive","not_applicable"]},"method":{"type":"string","minLength":1},"limitations":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"origin":{"$ref":"#/$defs/origin"},"sources":{"type":"array","items":{"$ref":"#/$defs/source"},"minItems":1},"evaluator":{"$ref":"#/$defs/producer"},"extensions":{"type":"object"}},"required":["schema","type","bridge","trial_episode","verdict","method","limitations","origin","sources","evaluator","extensions"],"additionalProperties":false},
    "motif": {"type":"object","properties":{"schema":{"const":"dscc.atlas/0.1-draft"},"type":{"const":"Motif"},"title":{"type":"string","minLength":1},"nodes":{"type":"array","items":{"$ref":"#/$defs/node"},"minItems":1},"links":{"type":"array","items":{"$ref":"#/$defs/link"},"minItems":0},"members":{"type":"array","items":{"type":"object","properties":{"episode":{"$ref":"#/$defs/cid"},"mapping":{"type":"array","items":{"$ref":"#/$defs/binding"},"minItems":1}},"required":["episode","mapping"],"additionalProperties":false},"minItems":1},"counterexamples":{"type":"array","items":{"$ref":"#/$defs/cid"},"minItems":0},"conditions":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"unresolved_differences":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"generator":{"$ref":"#/$defs/producer"},"extensions":{"type":"object"}},"required":["schema","type","title","nodes","links","members","counterexamples","conditions","unresolved_differences","generator","extensions"],"additionalProperties":false}
  }
}
